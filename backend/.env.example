# JWT_SECRET: kunci untuk menandatangani session token login.
# Generate contoh: openssl rand -hex 32 (opsional — kalau kosong, server generate sendiri secara otomatis)
JWT_SECRET=

# Password awal untuk 3 akun seed (opsional — kalau kosong, server buat password acak & tampilkan di log)
SEED_ADMIN_PASSWORD=
SEED_ASSESSOR_PASSWORD=
SEED_VIEWER_PASSWORD=