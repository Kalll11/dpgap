# JWT_SECRET: kunci untuk menandatangani session token login.
# Generate contoh: openssl rand -hex 32 (opsional — kalau kosong, server generate sendiri secara otomatis)
JWT_SECRET=

# Password awal untuk akun seed (opsional — kalau kosong, server buat password acak & tampilkan di log)
SEED_ADMIN_PASSWORD=
SEED_ASSESSOR_PASSWORD=

# Password akun dummy/demo (demo@telkomhub.co.id, role Assessor). Kalau kosong,
# fallback ke 'Demo@12345' secara tetap (BUKAN acak) — supaya tombol "Masuk Cepat
# sebagai Demo" di halaman login selalu bisa dipakai. Kosongkan/hapus akun ini
# sebelum deploy ke produksi.
SEED_DEMO_PASSWORD=